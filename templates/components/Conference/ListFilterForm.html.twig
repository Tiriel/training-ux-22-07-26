<div{{ attributes }}>
    {{ form_start(form) }}
        {{ form_row(form.fromDate, {
            attr: {
                'data-action': 'blur->live#action',
                'data-live-action-param': 'filter',
            }
        }) }}
        {{ form_row(form.toDate, {
            attr: {
                'data-action': 'blur->live#action',
                'data-live-action-param': 'filter',
            }
        }) }}
    {{ form_end(form) }}
</div>
