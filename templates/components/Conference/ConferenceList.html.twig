<div {{ attributes }}>
    {% if selectedConference %}
        <!-- Conference Details View -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>{{ selectedConference.name }}</h2>
            <button
                class="btn btn-outline-secondary"
                {{ live_action('backToList') }}>
                Back to List
            </button>
        </div>
        <twig:Conference:ConferenceListDetails :selectedConference="selectedConference"/>
    {% else %}
        <!-- Conference Listing -->
        <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">
            {% for conference in this.conferences %}
                <twig:Conference:Card :conference="conference" />
            {% else %}
                <div> There are no conferences yet...</div>
            {% endfor %}
        </div>
    {% endif %}
</div>
